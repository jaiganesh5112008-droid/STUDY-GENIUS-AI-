rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredLanguage is string &&
             data.preferredLanguage in ['ENGLISH', 'TAMIL', 'HINDI', 'MALAYALAM', 'TELUGU', 'KANNADA'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidStudyNote(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.subject is string &&
             data.subject.size() >= 1 &&
             data.subject.size() <= 80 &&
             data.category is string &&
             data.category in ['NOTE', 'SUMMARY', 'AI_ANSWER'] &&
             data.style is string &&
             data.style.size() >= 1 &&
             data.style.size() <= 80 &&
             data.sourceName is string &&
             data.sourceName.size() <= 200 &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 50000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidQuiz(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.subject is string &&
             data.subject.size() >= 1 &&
             data.subject.size() <= 80 &&
             data.sourceType is string &&
             data.sourceType in ['PDF', 'DOCX', 'TXT', 'IMAGE', 'NOTES', 'MOCK_TEST'] &&
             data.sourceName is string &&
             data.sourceName.size() <= 200 &&
             data.difficulty is string &&
             data.difficulty in ['Easy', 'Medium', 'Hard'] &&
             data.questionType is string &&
             data.questionType in ['MCQ', 'TRUE_FALSE', 'FILL_BLANKS', 'SHORT_ANSWER'] &&
             data.durationMinutes is int &&
             data.durationMinutes >= 1 &&
             data.durationMinutes <= 180 &&
             data.questionCount is int &&
             data.questionCount >= 1 &&
             data.questionCount <= 100 &&
             data.questions is list &&
             data.questions.size() >= 1 &&
             data.questions.size() <= 100 &&
             data.questions[0] is map &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidQuizAttempt(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.quizId is string &&
             isValidId(data.quizId) &&
             data.quizTitle is string &&
             data.quizTitle.size() >= 1 &&
             data.quizTitle.size() <= 200 &&
             data.subject is string &&
             data.subject.size() >= 1 &&
             data.subject.size() <= 80 &&
             data.mockTest is bool &&
             data.score is int &&
             data.score >= 0 &&
             data.score <= 100 &&
             data.totalQuestions is int &&
             data.totalQuestions >= 1 &&
             data.totalQuestions <= 100 &&
             data.score <= data.totalQuestions &&
             data.percentage is int &&
             data.percentage >= 0 &&
             data.percentage <= 100 &&
             data.timeSpentSeconds is int &&
             data.timeSpentSeconds >= 0 &&
             data.timeSpentSeconds <= 86400 &&
             data.userAnswers is map &&
             data.userAnswers.size() <= 100 &&
             data.completedAt is timestamp &&
             data.completedAt <= request.time &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // --- USER PROFILE (PII ISOLATED TO OWNER) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- CLOUD STUDY NOTES ---
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'title', 'subject', 'category', 'style', 'sourceName', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'subject', 'category', 'style', 'sourceName', 'content', 'createdAt', 'updatedAt']) &&
                         isValidStudyNote(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidStudyNote(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'content', 'style', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // --- CLOUD QUIZZES ---
      match /quizzes/{quizId} {
        allow get: if isOwner(userId) && isValidId(quizId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(quizId) &&
                         incoming().keys().hasAll(['userId', 'title', 'subject', 'sourceType', 'sourceName', 'difficulty', 'questionType', 'durationMinutes', 'questionCount', 'questions', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'subject', 'sourceType', 'sourceName', 'difficulty', 'questionType', 'durationMinutes', 'questionCount', 'questions', 'createdAt', 'updatedAt']) &&
                         isValidQuiz(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(quizId) &&
                         isValidQuiz(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(quizId);
      }

      // --- CLOUD QUIZ HISTORY (ATTEMPTS) ---
      match /quizAttempts/{attemptId} {
        allow get: if isOwner(userId) && isValidId(attemptId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(attemptId) &&
                         incoming().keys().hasAll(['userId', 'quizId', 'quizTitle', 'subject', 'mockTest', 'score', 'totalQuestions', 'percentage', 'timeSpentSeconds', 'userAnswers', 'completedAt', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'quizId', 'quizTitle', 'subject', 'mockTest', 'score', 'totalQuestions', 'percentage', 'timeSpentSeconds', 'userAnswers', 'completedAt', 'createdAt', 'updatedAt']) &&
                         isValidQuizAttempt(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(attemptId);
      }
    }
  }
}
